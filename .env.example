# ============================================================
# NEO Support System - Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control!
# ============================================================

# ------------------------------------------------------------
# Supabase Configuration (Required)
# ------------------------------------------------------------
# Get these from your Supabase project settings:
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ------------------------------------------------------------
# LINE Messaging API Configuration (Required for LINE integration)
# ------------------------------------------------------------
# LINE Channel Access Token (from LINE Developers Console)
LINE_CHANNEL_ACCESS_TOKEN="your-channel-access-token-here"

# LINE Channel Secret (from LINE Developers Console)
LINE_CHANNEL_SECRET="your-channel-secret-here"

# LINE Login Configuration (Optional - for staff login)
NEXT_PUBLIC_LINE_LOGIN_CLIENT_ID="your-line-login-client-id-here"
LINE_LOGIN_CLIENT_ID="your-line-login-client-id-here"
LINE_LOGIN_CLIENT_SECRET="your-line-login-client-secret-here"

# LINE Staff Group ID (for staff notifications)
LINE_STAFF_GROUP_ID="your-staff-group-id-here"

# LINE Rich Menu ID (for staff menu)
LINE_STAFF_RICH_MENU_ID="your-rich-menu-id-here"

# ------------------------------------------------------------
# Application Configuration (Required)
# ------------------------------------------------------------
# Your application's base URL (change in production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# LINE OA URL for customer redirect after registration
NEXT_PUBLIC_LINE_OA_URL="https://line.me/R/ti/p/@yourlineaid"

# ------------------------------------------------------------
# AI Configuration (Optional - for AI features)
# ------------------------------------------------------------
# Google Gemini API Key (for AI categorization and summarization)
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_GEMINI_API_KEY="your-gemini-api-key-here"

# ------------------------------------------------------------
# Security & Maintenance (Optional)
# ------------------------------------------------------------
# Cron Secret for scheduled tasks (generate a random string)
CRON_SECRET="your-secure-random-string-here"

# ============================================================
# Development Only - DO NOT use these in production
# ============================================================
# NODE_ENV="development"
